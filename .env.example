# FlowPilot Environment Configuration
# HackNowa Global Hackathon 2026 - Future of Work & Automation
#
# NOTE: FlowPilot runs completely 100% offline & keyless by default!
# The built-in deterministic workflow generator creates rich, structured
# workflows for any prompt without requiring any external API key.
#
# If you wish to enable live AI-powered prompt generation via Gemini or OpenAI,
# copy this file to `.env.local` and add your secret key below:

# Optional: Google Gemini API Key
GEMINI_API_KEY=

# Optional: OpenAI API Key
OPENAI_API_KEY=

# Next.js environment
NEXT_PUBLIC_APP_NAME=FlowPilot
NEXT_PUBLIC_APP_VERSION=1.0.0
